# Django settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/mashujaa_voices

# AI Providers
VISION_PROVIDER=gemini
TTS_PROVIDER=groq

# Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Gemini Models
GEMINI_VALIDATION_MODEL=gemini-2.0-flash-lite
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICES=Kore,Puck,Charon,Fenrir,Aoede
GEMINI_TTS_DEFAULT_VOICE=Kore

# Groq API
GROQ_API_KEY=your-groq-api-key

# Groq TTS Models
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICES=autumn,diana,hannah,austin,daniel,troy
GROQ_TTS_DEFAULT_VOICE=autumn
GROQ_TTS_ENDPOINT=https://api.groq.com/openai/v1/audio/speech

# Groq Vision Models
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Qwen/DashScope API (optional)
DASHSCOPE_API_KEY=your-dashscope-api-key

# Qwen TTS Models
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICES=Cherry,Serena,Ethan,Chelsie
QWEN_TTS_DEFAULT_VOICE=Cherry
QWEN_TTS_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/text2audio/synthesis

# Edge TTS
EDGE_TTS_URL=https://openai-edge-tts-lf7c.onrender.com
EDGE_TTS_VOICES=autumn,diana,hannah,austin,daniel,troy

# Model Parameters
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=1000
VALIDATION_TEMPERATURE=0.5
VALIDATION_MAX_TOKENS=300
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT=60.0

# Supabase Storage (S3-compatible)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_BUCKET_IMAGES=mashujaa-images
SUPABASE_BUCKET_AUDIO=mashujaa-audio

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
